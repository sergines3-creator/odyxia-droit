# COR — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs

# ── Sécurité API ──────────────────────────────────────────────────
# Clé partagée entre le serveur COR et les projets clients (ODYXIA IA, etc.)
# Générer une clé sécurisée : python -c "import secrets; print(secrets.token_hex(32))"
COR_API_KEY=monprojet2026

# ── Mode actif ────────────────────────────────────────────────────
# false = le serveur répond {"fallback": true} sans appeler le modèle
# Mettre à false pendant l'entraînement pour ne pas bloquer le serveur
COR_ACTIF=true

# ── Limites ───────────────────────────────────────────────────────
COR_MAX_TOKENS=150

# ── Flask ─────────────────────────────────────────────────────────
FLASK_DEBUG=false
